# ==================== REPOSITORIOS ====================
GITLAB_URL=https://tu-gitlab.com/git/
GITLAB_TOKEN=your_gitlab_token_here
GITHUB_TOKEN=

# ==================== AZURE LLM (NTT) ====================
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SCOPE=
AZURE_API_BASE=
AZURE_LLM_MODEL=gpt-4
AZURE_API_VERSION=2024-04-01-preview
AZURE_USER_ID=

# ==================== AZURE OPENAI ====================
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# ==================== EMBEDDINGS ====================
AZURE_EMBEDDER_API_KEY=
AZURE_EMBEDDER_API_BASE=
AZURE_EMBEDDER_MODEL=text-embedding-ada-002

# ==================== ANTHROPIC (OPCIONAL) ====================
AXET_ANTHROPIC_TENANT_ID=
AXET_ANTHROPIC_APP_ID=
AXET_ANTHROPIC_CLIENT_SECRET=
AXET_ANTHROPIC_ENDPOINT=
AXET_ANTHROPIC_USER_ID=

# ==================== OPENAI (BACKUP) ====================
OPENAI_API_KEY=

# ==================== JIRA ====================
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=

# ==================== API ====================
API_PORT=8001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==================== ANALYSIS ====================
ANALYSIS_MODE=intelligent
ENABLE_LLM_INSIGHTS=true
ENABLE_RECOMMENDATIONS=true

# ==================== OUTPUTS ====================
OUTPUTS_DIR=outputs
LOGS_DIR=logs
